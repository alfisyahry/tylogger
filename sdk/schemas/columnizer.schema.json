{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TyloggerColumnizerConfig",
  "type": "object",
  "required": ["id", "name", "format", "columns"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": ["delimited", "regex", "jsonl"]
    },
    "delimiter": {
      "type": "string",
      "maxLength": 1
    },
    "pattern": {
      "type": "string",
      "description": "Regular expression with named capture groups"
    },
    "columns": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
