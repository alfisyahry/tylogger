{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TyloggerPluginManifest",
  "type": "object",
  "required": ["id", "name", "version", "category"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (e.g. com.example.myparser)"
    },
    "name": {
      "type": "string",
      "description": "User-facing display name"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["columnizer", "keyword_action", "context_menu"]
    },
    "api_version": {
      "type": "string",
      "default": "1.0"
    },
    "min_app_version": {
      "type": "string",
      "default": "0.4.0"
    },
    "columnizer_config": {
      "type": "string",
      "description": "Relative path to columnizer.json (declarative)"
    },
    "executable": {
      "type": "string",
      "description": "Relative path to executable binary (out-of-process)"
    }
  }
}
